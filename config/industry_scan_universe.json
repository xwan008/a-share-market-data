  "completion_contract": {
    "taxonomy_counts_required": {"level1":31,"level2":134,"level3":346},
    "required_research_state_diagnostics": [
      "coverage.taxonomy",
      "coverage.expected_counts",
      "coverage.accounted_for_counts",
      "coverage.missing_level1",
      "coverage.missing_level2",
      "coverage.missing_level3",
      "coverage.unresolved_must_split_chains",
      "coverage.completion_gate_passed"
    ],
    "completion_gate": [
      "accounted_for_counts.level1必须等于31",
      "accounted_for_counts.level2必须等于134",
      "accounted_for_counts.level3必须等于346",
      "missing_level1/missing_level2/missing_level3必须为空",
      "所有被标记为must_split/continue_split的盈利链必须完成继续拆解或明确降级为unconfirmed并说明原因",
      "所有强改善或显著分化节点必须进入盈利链拆解；弱/稳定节点允许只保留Coverage状态和简短证据",
      "completion_gate_passed=false时，18:00研究状态只能标记incomplete_research，不得生成新的当前机会，也不得用不完整结果覆盖上一份有效完整研究结论"
    ],
    "required_output_per_broad_industry":["broad_industry","subchains_scanned","t2_subchains","t1_subchains","t0_subchains","unconfirmed_subchains","coverage_gap"],
    "required_output_per_t2_subchain":["subchain","direct_profit_driver","leading_variables","evidence","main_value_chain_links","eligible_main_board_companies_recalled","coverage_gap"],
    "forbidden_shortcuts":["先列熟悉公司再倒推产业链","用几个龙头财报代表整个大行业","未完成31/134/346 Coverage对齐就宣布全市场扫描完成","只扫描热门行业","因为周度补漏池出现某公司而新增或升级T2","把申万三级行业直接当作最终盈利链而跳过盈利Driver三问"]
  }
