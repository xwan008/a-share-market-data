{
  "schema_version": 2,
  "purpose": "A股低风险买点榜产业景气主流程的固定Coverage骨架。申万行业分类负责防漏与完成度验收，不负责决定景气答案；盈利产业链仍由Prompt按当期经济盈利机制动态发现和递归拆解。",
  "taxonomy_reference": {
    "name": "申万行业分类标准2021版",
    "role": "coverage_only_not_answer_pool",
    "expected_level1_count": 31,
    "expected_level2_count": 134,
    "expected_level3_count": 346,
    "official_reference": "https://www.swsresearch.com/institute_sw/allIndex/downloadCenter/industryType",
    "count_basis": "申万行业分类标准2021版：31个一级行业、134个二级行业、346个三级行业",
    "rules": [
      "31/134/346是18:00完整研究的Coverage验收基线，不是景气候选池，也不是固定盈利链答案。",
      "每次18:00完整研究必须让全部31个一级、134个二级、346个三级分类在Coverage层被accounted_for；可以是强/改善/稳定/弱/混合/未确认/不适用，但不得无状态消失。",
      "Coverage层只要求确认节点是否已检查及其当期状态，不要求对346个三级行业全部做同等深度公司研究；只有出现改善、恶化或显著分化的节点才进入深度盈利链研究。",
      "申万三级行业仍可能包含不同直接盈利Driver；进入重点研究后必须继续按产品、工艺、应用场景、客户需求来源和成本结构拆盈利链。",
      "若跨申万行业的公司共享同一真实盈利机制，可以形成跨行业盈利链，但必须保留其Coverage来源映射。",
      "若申万官方未来调整分类数量或结构，先更新本Coverage基线，再执行完整研究；不得在一次研究中临时自行修改基线。"
    ]
  },
  "coverage_rules": {
    "all_broad_industries_must_be_scanned": true,
    "all_sw_level1_nodes_must_be_accounted_for": true,
    "all_sw_level2_nodes_must_be_accounted_for": true,
    "all_sw_level3_nodes_must_be_accounted_for": true,
    "minimum_subchains_are_floor_not_ceiling": true,
    "dynamic_new_subchains_must_be_added_when_public_evidence_requires": true,
    "broad_industry_cannot_be_final_t2_unit": true,
    "every_minimum_subchain_requires_status_or_explicit_not_applicable_reason": true,
    "scan_complete_only_if_every_broad_industry_has_coverage_result": true,
    "scan_complete_only_if_sw_counts_match": true,
    "scan_complete_only_if_no_unresolved_must_split_chain": true,
    "weekly_stock_pool_must_not_influence_industry_scan": true
  },
  "broad_industries": [
