{
  "contract_id": "a-share-low-risk-production",
  "pipeline": "a_share_low_risk",
  "mode": "production",
  "authoritative_skills": {
    "orchestrator": "skills/a-share-low-risk/orchestrator/SKILL.md",
    "company_research": "skills/a-share-low-risk/company-research/SKILL.md",
    "valuation": "skills/a-share-low-risk/valuation/SKILL.md",
    "price_structure": "skills/a-share-low-risk/price-structure/SKILL.md"
  },
  "authoritative_data": {
    "industry_coverage_taxonomy": "config/industry_scan_universe.json",
    "company_index": "data/research/company_industry_index.json",
    "full_market_price_structure": "data/research/full_market_price_structure.json",
    "latest_market": "data/latest.json",
    "market_health": "data/health.json",
    "bounded_history_store": "data/history_shards/*.json",
    "industry_state": "data/research/industry_state.json",
    "research_state": "data/research/research_state.json"
  },
  "stage_order": [
    "data_gate",
    "prompt_full_market_discovery",
    "taxonomy_mapping",
    "level3_profitability_refresh",
    "company_admission_gate",
    "profit_chain_resolution",
    "company_mapping_gate",
    "company_light_screen",
    "company_comparison_and_dedup",
    "valuation",
    "price_structure",
    "buy_point_synthesis",
    "completion_gate",
    "publish"
  ],
  "data_gate_contract": {
    "fail_closed": true,
    "expected_trade_date_must_equal_health_trade_date": true,
    "market_status_must_be_closed": true,
    "source_errors_must_be_empty": true,
    "quote_coverage_must_not_be_materially_degraded": true,
    "history_must_cover_expected_trade_date": true,
    "price_structure_must_cover_expected_trade_date": true,
    "on_failure": "data_stale_or_incomplete",
    "publish_on_failure": false,
    "mutate_valid_state_on_failure": false
  },
  "discovery_contract": {
    "method": "prompt_full_market_light_recall_every_run",
    "previous_focus_list_may_not_seed_or_bound_discovery": true,
    "previous_companies_chains_valuations_or_opportunities_may_not_seed_discovery": true,
    "top_n_or_fixed_count_selection_forbidden": true,
    "must_cover_major_economic_domains": [
      "资源能源",
      "化工材料",
      "制造设备",
      "科技",
      "消费",
      "医药",
      "金融地产",
      "公用事业交通运输",
      "农业"
    ],
    "primary_evidence": [
      "行业收入利润与利润率",
      "产品价格与价差",
      "库存与开工率或产能利用率",
      "订单出货销量产量",
      "进出口与供需",
      "代表性公司经营数据",
      "改变供需或成本的政策"
    ],
    "market_price_or_sector_return_cannot_be_primary_evidence": true,
    "taxonomy_is_routing_after_discovery": true,
    "persistent_level1_level2_prosperity_labels_forbidden": true
  },
  "level3_state_contract": {
    "taxonomy": "申万行业分类标准2021版",
    "expected_counts": {"level1": 31, "level2": 134, "level3": 346},
    "bootstrap_full_refresh_required_when_state_missing_invalid_or_requires_full_refresh": true,
    "bootstrap_ignores_weekly_anchor": true,
    "bootstrap_must_complete_before_daily_incremental_mode": true,
    "weekly_full_refresh_anchor": "Friday 18:00 Asia/Shanghai",
    "weekly_full_refresh_fallback": "next available weekday 18:00",
    "daily_incremental_refresh": true,
    "prompt_discovery_is_full_market_even_on_daily_incremental_runs": true,
    "daily_refresh_only_deep_rechecks_level3_nodes_with_new_or_changed_evidence": true,
    "weekly_refresh_revalidates_all_level3_nodes_mapped_from_current_discovered_directions": true,
    "unselected_level3_may_remain_taxonomy_only": true,
    "required_profitability_fields": [
      "code",
      "name",
      "trend",
      "strength",
      "breadth",
      "confidence",
      "evidence_basis",
      "leading_variables",
      "profit_driver",
      "falsifiers",
      "last_verified_at"
    ],
    "allowed_trend": ["improving", "stable", "deteriorating", "unconfirmed"],
    "allowed_breadth": ["broad", "divergent", "narrow", "unconfirmed"]
  },
  "company_admission_contract": {
    "admit_if": [
      "trend=improving",
      "trend=stable AND breadth=divergent"
    ],
    "exclude_if": [
      "trend=deteriorating",
      "trend=stable AND breadth!=divergent",
      "trend=unconfirmed"
    ],
    "stable_divergent_only_broadens_research_eligibility": true,
    "stable_divergent_does_not_lower_valuation_structure_or_buy_point_thresholds": true,
    "admitted_chain_requires_resolved_driver_and_profit_transmission": true,
    "research_admission_top_n_forbidden": true,
    "per_level1_chain_cap_forbidden": true
  },
  "company_mapping_gate": {
    "company_index_may_be_globally_degraded": true,
    "all_missing_or_unmapped_codes_must_be_checked_against_admitted_level3_scope": true,
    "unresolved_in_scope_mapping_forbidden": true,
    "out_of_scope_missing_mapping_may_be_documented_and_continue": true,
    "on_unresolved_in_scope_mapping": "incomplete_research",
    "silent_omission_forbidden": true
  },
  "company_comparison_contract": {
    "company_light_screen": {
      "all_mapped_mainboard_companies_in_admitted_chain_must_be_screened": true,
      "top_n_or_score_cutoff_before_screen_forbidden": true,
      "exclusion_requires_company_specific_evidence": true,
      "all_survivors_enter_horizontal_comparison": true,
      "core_earnings_evidence_required_for_survive": true,
      "deducted_netprofit_or_equivalent_core_earnings_must_be_checked": true,
      "missing_core_earnings_evidence_cannot_default_to_earnings_quality_match_true": true,
      "missing_core_earnings_requires_current_public_evidence_supplement_or_data_unavailable": true,
      "nonrecurring_dominance_threshold_of_parent_netprofit": 0.30,
      "allowed_exclusion_reasons": [
        "business_exposure_mismatch",
        "profit_driver_mismatch",
        "earnings_quality_mismatch",
        "nonrecurring_earnings_dominant",
        "major_business_change",
        "not_economically_comparable",
        "data_unavailable"
      ]
    },
    "horizontal_comparison_must_cover_all_screen_survivors": true,
    "cross_chain_dedup_after_comparison": true,
    "dedup_key": "stock_code",
    "dedup_must_preserve_all_source_chain_ids": true,
    "valuation_set_must_be_deduplicated_by_stock_code": true
  },
  "valuation_contract": {
    "default_path": "relative_earnings_valuation",
    "complex_model_is_exception_not_default": true,
    "normal_company_complex_model_forbidden_as_default": true,
    "default_path_required_inputs": [
      "core_forward_eps",
      "current_pe_or_ttm_pe",
      "dynamic_pe_if_available",
      "pb",
      "roe",
      "core_profit_growth",
      "level3_peer_pe_median",
      "level3_peer_pb_median",
      "price_180d_low",
      "price_180d_median",
      "price_180d_high",
      "price_180d_percentile"
    ],
    "corporate_action_check_required_before_earnings_bridge": true,
    "material_share_count_change_threshold_pct": 5.0,
    "historical_eps_direct_scaling_across_material_share_count_change_forbidden": true,
    "when_share_count_changes_use_aggregate_earnings_and_current_or_forward_diluted_share_count": true,
    "core_earnings_preferred_over_parent_netprofit_when_nonrecurring_dominant": true,
    "parent_netprofit_contaminated_by_material_nonrecurring_items_cannot_feed_forward_bridge": true,
    "fair_pe_construction": {
      "level3_peer_pe_is_primary_relative_anchor": true,
      "dynamic_pe_is_reference_not_fair_value_copy": true,
      "core_profit_growth_adjustment_required": true,
      "pb_roe_cross_check_required": true
    },
    "market_sanity": {
      "history_window_trading_days": 180,
      "sanity_only_not_reverse_engineering": true
    },
    "exception_path_triggers": [
      "negative_or_unusable_pe",
      "major_restructuring",
      "material_one_off_contamination",
      "bank_or_insurer_balance_sheet_model",
      "extreme_cycle_distortion",
      "unresolved_pe_pb_peer_conflict",
      "unresolved_model_market_sanity_conflict",
      "business_model_break"
    ],
    "exception_path_models": ["pb_roe", "residual_income", "ev_ebitda", "nav_dcf", "fcf_dcf", "case_specific"],
    "exception_trigger_required": true,
    "single_mos_application_required": true,
    "safe_price_ceiling_formula": "base_fair_value * (1 - margin_of_safety_pct)",
    "fixed_discount_from_reasonable_lower_bound_forbidden": true
  },
  "price_structure_contract": {
    "independent_from_valuation": true,
    "full_market_scan_required": true,
    "allowed_structure_types": ["base_not_started", "transition", "breakout", "pullback", "trend_continuation", "overheated", "damaged", "unavailable"],
    "timing_eligible_types": ["breakout", "pullback", "trend_continuation"],
    "damaged_or_overheated_cannot_be_timing_eligible": true,
    "structure_entry_range_must_not_reference_fair_value": true
  },
  "buy_point_contract": {
    "hard_value_gate": "current_price <= safe_price_ceiling",
    "buy_price_range_formula": "structure_entry_range intersect (-infinity, safe_price_ceiling]",
    "empty_intersection_means_not_buyable_now": true,
    "damaged_or_overheated_cannot_be_buyable_now": true,
    "buyable_now_requires_value_and_timing_true": true,
    "price_structure_must_not_modify_intrinsic_value": true,
    "near_miss_ranking_contract": {
      "buyable_now_stays_separate": true,
      "must_output_when_eligible_universe_nonempty": true,
      "review_required_excluded_from_distance_ranking": true,
      "ranking_is_display_only_not_candidate_pool": true,
      "cross_run_persistence_as_pool_forbidden": true,
      "default_display_limit": 10,
      "research_admission_top_n_forbidden": true,
      "required_metrics": ["missing_hard_conditions", "value_gap_pct", "structure_gap_pct", "action_distance_pct", "distance_band", "current_missing", "next_trigger"],
      "action_distance_formula": "max(value_gap_pct, structure_gap_pct) when both are measurable",
      "distance_bands": {"near": "<=5%", "watch": ">5% and <=15%", "far": ">15%"},
      "sort_order": ["missing_hard_conditions", "distance_band", "action_distance_pct", "fundamental_score", "stock_code"],
      "unmeasurable_structure_gap_after_measurable_in_same_bucket": true
    }
  },
  "completion_gate_contract": {
    "data_gate_passed": true,
    "prompt_full_market_discovery_complete": true,
    "no_discovery_top_n_truncation": true,
    "all_discovered_directions_taxonomy_mapped": true,
    "all_required_level3_refreshes_complete": true,
    "all_admitted_chains_resolved": true,
    "all_admitted_chains_company_screened": true,
    "company_mapping_gate_passed": true,
    "all_light_screen_survivors_compared": true,
    "valuation_set_dedup_complete": true,
    "all_valuation_set_companies_fully_valued_or_explicit_review": true,
    "all_complete_non_review_companies_have_price_structure": true,
    "all_complete_non_review_companies_have_buy_point_assessment": true,
    "near_miss_ranking_complete_when_eligible_universe_nonempty": true,
    "current_opportunities_must_come_only_from_buyable_now": true,
    "on_failure": "incomplete_research",
    "publish_on_failure": false,
    "mutate_previous_valid_state_on_failure": false
  },
  "persistence_contract": {
    "industry_state_path": "data/research/industry_state.json",
    "research_state_path": "data/research/research_state.json",
    "industry_state_is_only_cross_run_fundamental_memory": true,
    "research_state_contains_latest_valid_formal_run_only": true,
    "persistent_candidate_or_opportunity_pools_forbidden": true,
    "standalone_valuation_cache_forbidden": true,
    "failed_or_stale_run_must_not_overwrite_valid_state": true,
    "old_v2_state_is_legacy_and_not_runtime_input": true
  },
  "public_output": {
    "formal_publish_enabled": true,
    "sections": [
      "【执行状态】",
      "【全市场景气发现】",
      "【三级行业盈利状态】",
      "【产业链与公司轻筛】",
      "【估值与安全价】",
      "【价格结构与时机】",
      "【当前买点】",
      "【接近买点榜】",
      "【诊断与失效条件】"
    ],
    "near_miss_section_title": "【接近买点榜】",
    "near_miss_must_be_nonempty_when_eligible_universe_nonempty": true,
    "no_buyable_now_may_be_reported_as_zero_without_lowering_thresholds": true
  }
}
