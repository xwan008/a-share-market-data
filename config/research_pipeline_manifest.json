{
  "schema_version": 28,
  "pipeline": "a_share_low_risk_v2",
  "mode": "shadow",
  "architecture": "prompt_first_research",
  "production_gate": {
    "enabled": false,
    "label": "V2影子研究，不发布正式买点"
  },
  "authoritative_skills": {
    "orchestrator": "skills/a-share-low-risk/orchestrator/SKILL.md",
    "company_research": "skills/a-share-low-risk/company-research/SKILL.md",
    "valuation": "skills/a-share-low-risk/valuation/SKILL.md",
    "price_structure": "skills/a-share-low-risk/price-structure/SKILL.md"
  },
  "authoritative_data": {
    "industry_coverage_taxonomy": "config/industry_scan_universe.json",
    "company_index": "data/research/company_industry_index.json",
    "full_market_price_structure": "data/research/v2/full_market_price_structure.json",
    "latest_market": "data/latest.json",
    "bounded_history_store": "data/history_shards/*.json",
    "research_state": "data/research/v2/research_state.json"
  },
  "evidence_contract": {
    "repository_whitelist_applies_only_to_persistent_mechanical_data": true,
    "current_public_research_evidence_allowed": true,
    "current_public_research_evidence_required_for_1800_research": true,
    "preferred_sources": [
      "公司公告与财报",
      "交易所披露",
      "官方统计",
      "行业协会与产业公开数据",
      "可信商品价格/价差/订单/产销数据",
      "必要时高质量新闻与研究资料"
    ],
    "evidence_uses": [
      "行业收入利润与利润率",
      "订单/出货/销量/产量",
      "产品价格与价差",
      "库存/开工/产能利用率",
      "公司主营/扣非/现金流",
      "Forward Bridge与反向证据"
    ],
    "public_evidence_must_not_be_persisted_as_cross_run_candidate_or_opportunity_pool": true
  },
  "stage_order": [
    "data_health",
    "taxonomy_coverage",
    "profitability_scan",
    "profit_chain_decomposition",
    "chain_company_light_screen",
    "chain_company_comparison_and_dedup",
    "valuation",
    "price_structure",
    "buy_point_synthesis",
    "completion_gate"
  ],
  "scan_cadence_contract": {
    "full_scan_unit": "level3",
    "full_scan_expected_level3_nodes": 346,
    "weekly_full_scan_interval_days": 7,
    "preferred_anchor": "Friday 18:00 Asia/Shanghai",
    "fallback": "若周五18:00全量失败或未运行，则下一次可用工作日18:00补做weekly_full",
    "bootstrap_rule": "没有当前schema有效周度基线时，下一次18:00必须立即执行全量普查，不等待周五",
    "daily_incremental_between_full_scans": true,
    "level1_level2_may_be_derived_from_level3_children": true,
    "full_scan_is_market_state_baseline_not_candidate_pool": true,
    "daily_incremental_trigger_sources": [
      "新财报/业绩预告/快报",
      "行业统计更新",
      "产品价格或价差显著变化",
      "订单/出货/销量/产量变化",
      "库存/开工/产能利用率变化",
      "重大公司公告",
      "产业供需或政策事件"
    ],
    "daily_carry_forward_allowed_only_from_valid_weekly_baseline": true,
    "daily_carry_forward_must_record_baseline_date": true,
    "previous_companies_chains_or_opportunities_may_not_seed_discovery": true,
    "calendar_anchor_is_authoritative": true,
    "interval_days_is_max_baseline_age_not_minimum_wait": true,
    "successful_bootstrap_next_full_scan": "最近一个Friday 18:00 Asia/Shanghai，即使距离bootstrap不足7天也执行weekly_full",
    "friday_full_scan_rule": "每周五18:00只要数据健康即执行weekly_full；其他工作日18:00执行daily_incremental，除非需要补做失败的周五全量"
  },
  "coverage_contract": {
    "taxonomy": "申万行业分类标准2021版",
    "expected_counts": {
      "level1": 31,
      "level2": 134,
      "level3": 346
    },
    "ledger_contract": {
      "state_path": "coverage_ledger",
      "instantiate_all_taxonomy_nodes_before_profitability_scan": true,
      "exact_node_counts_must_match_taxonomy": true,
      "required_node_fields": [
        "code",
        "name",
        "level",
        "parent_code",
        "accounted_for",
        "trend",
        "strength",
        "breadth",
        "confidence",
        "scan_depth",
        "evidence_scope",
        "evidence_basis",
        "last_full_scan_date",
        "baseline_date",
        "daily_trigger",
        "needs_profit_chain_research",
        "profit_chain_resolution"
      ],
      "allowed_trend": [
        "improving",
        "stable",
        "deteriorating",
        "unconfirmed"
      ],
      "allowed_strength": [
        "strong",
        "normal",
        "weak",
        "unknown"
      ],
      "allowed_breadth": [
        "broad",
        "selective",
        "divergent",
        "unknown"
      ],
      "allowed_confidence": [
        "high",
        "medium",
        "low"
      ],
      "allowed_scan_depth": [
        "shallow",
        "deep"
      ],
      "allowed_evidence_scope": [
        "direct_node",
        "child_aggregate",
        "cross_sectional",
        "carried_forward",
        "insufficient"
      ],
      "deep_trigger_rule": "trend为improving或deteriorating，或breadth为selective/divergent时必须deep并进入盈利链研究",
      "accounted_for_definition": "节点必须有唯一记录且四维状态、证据、扫描日期和流转字段完整；默认unconfirmed占位不能算周度全量完成。",
      "weekly_level3_generic_unconfirmed_placeholder_forbidden": true,
      "weekly_level3_each_node_requires_real_evidence_review": true,
      "daily_no_trigger_node_may_carry_forward_valid_baseline": true,
      "grouped_placeholder_rows_forbidden": true,
      "null_accounted_for_counts_forbidden": true,
      "missing_arrays_must_contain_actual_taxonomy_codes": true,
      "counts_must_be_derived_from_ledger_not_manually_asserted": true
    },
    "profitability_discovery_gate": {
      "weekly_full_scan_requires_all_346_level3_reviewed": true,
      "weekly_full_scan_requires_last_full_scan_date_on_all_level3": true,
      "daily_incremental_requires_valid_baseline_not_older_than_days": 7,
      "daily_incremental_requires_trigger_check_or_explicit_carry_forward_for_every_level3": true,
      "level1_level2_aggregation_must_be_auditable": true
    }
  },
  "profit_chain_resolution_contract": {
    "required_for_each_deep_coverage_node": true,
    "allowed_resolution": [
      "resolved",
      "unconfirmed_with_evidence_gap"
    ],
    "must_split_or_continue_split_cannot_remain_open": true,
    "research_admission_top_n_forbidden": true,
    "per_level1_chain_cap_forbidden": true,
    "confirmed_improving_chain_definition": "由本期trend=improving节点拆出且resolution_status=resolved、Driver与利润传导已确认的盈利链",
    "every_confirmed_improving_chain_requires_company_light_screen": true,
    "non_improving_deep_chain_may_resolve_for_diagnostics_without_company_screen": true,
    "required_chain_fields": [
      "chain_id",
      "source_coverage_codes",
      "direct_driver",
      "leading_variables",
      "profit_transmission",
      "forward_bridge",
      "invalidation_condition",
      "resolution_status"
    ]
  },
  "company_comparison_contract": {
    "company_light_screen": {
      "all_mapped_mainboard_companies_in_confirmed_improving_chain_must_be_screened": true,
      "top_n_or_score_cutoff_before_screen_forbidden": true,
      "required_screen_fields": [
        "code",
        "name",
        "source_chain_ids",
        "business_exposure_match",
        "profit_driver_match",
        "earnings_quality_match",
        "comparability",
        "screen_decision",
        "exclusion_reason",
        "evidence_basis",
        "core_earnings_evidence",
        "core_earnings_trend",
        "nonrecurring_dominance_check",
        "valuation_earnings_basis_requirement"
      ],
      "allowed_screen_decision": [
        "survive",
        "exclude"
      ],
      "allowed_exclusion_reasons": [
        "insufficient_business_exposure",
        "profit_not_from_chain_driver",
        "earnings_deteriorating",
        "nonrecurring_earnings_dominant",
        "not_economically_comparable",
        "data_unavailable"
      ],
      "exclusion_requires_company_specific_evidence": true,
      "all_survivors_enter_horizontal_comparison": true,
      "core_earnings_evidence_required_for_survive": true,
      "deducted_netprofit_or_equivalent_core_earnings_must_be_checked": true,
      "missing_core_earnings_evidence_cannot_default_to_earnings_quality_match_true": true,
      "missing_core_earnings_requires_current_public_evidence_supplement_or_data_unavailable": true,
      "nonrecurring_dominance_threshold_of_parent_netprofit": 0.3,
      "nonrecurring_dominance_with_improving_core_earnings_may_survive_but_valuation_must_use_core_earnings": true,
      "nonrecurring_dominance_with_weak_or_unconfirmed_core_earnings_must_exclude": true
    },
    "comparison_occurs_before_final_valuation": true,
    "horizontal_comparison_must_cover_all_screen_survivors": true,
    "comparison_complete_required_when_survivors_exist": true,
    "single_company_chain_requires_explicit_singleton_reason": true,
    "cross_chain_dedup_after_comparison": true,
    "dedup_key": "stock_code",
    "dedup_must_preserve_all_source_chain_ids": true,
    "all_actually_compared_companies_enter_valuation_set": true,
    "valuation_set_must_be_deduplicated_by_stock_code": true,
    "same_company_valued_once_even_if_multiple_chain_memberships": true,
    "required_outputs": [
      "screened_companies",
      "excluded_companies",
      "compared_companies",
      "comparison_complete",
      "fundamental_best",
      "current_opportunity_best",
      "opportunity_resolution_complete",
      "singleton_reason"
    ],
    "current_opportunity_best_may_be_null": true,
    "required_diagnostics": [
      "confirmed_improving_chain_count",
      "company_screened_chain_count",
      "unscreened_confirmed_improving_chains",
      "light_screen_universe_company_count",
      "light_screen_excluded_count",
      "horizontal_comparison_survivor_count",
      "deduplicated_valuation_set_count"
    ],
    "completion_requires_no_unscreened_confirmed_improving_chains": true
  },
  "valuation_resolution_contract": {
    "valuation_set_path": "valuation_set",
    "every_valuation_set_company_requires_full_execution": true,
    "required_bridge_fields": [
      "current_price",
      "price_date",
      "earnings_type",
      "earnings_basis",
      "primary_method",
      "key_assumptions",
      "current_share_count",
      "share_count_basis",
      "corporate_action_check",
      "earnings_bridge_integrity",
      "reasonable_price_assumption",
      "reasonable_price_range",
      "uncertainty",
      "margin_of_safety_reason",
      "safe_price_range",
      "valuation_position",
      "falsifiers",
      "valuation_attempt_complete",
      "model_execution_status"
    ],
    "corporate_action_check_required_before_earnings_bridge": true,
    "historical_eps_direct_scaling_across_material_share_count_change_forbidden": true,
    "material_share_count_change_threshold_pct": 5.0,
    "when_share_count_changes_use_aggregate_earnings_and_current_or_forward_diluted_share_count": true,
    "major_restructuring_requires_comparability_audit": true,
    "resource_and_order_cycle_companies_cannot_use_growth_pe_from_current_profit_growth": true,
    "resource_and_order_cycle_require_normalized_or_scenario_earnings": true,
    "non_review_company_requires_non_null_reasonable_and_safe_ranges": true,
    "missing_analyst_consensus_is_not_valid_review_reason": true,
    "must_build_internal_forward_or_normalized_range_when_consensus_missing": true,
    "review_required_is_exception_not_successful_valuation": true,
    "allowed_review_exception_codes": [
      "major_restructuring",
      "nonrecurring_earnings_dominant",
      "critical_public_data_unavailable",
      "model_instability",
      "business_model_break",
      "other_material_blocker"
    ],
    "review_required_requires_completed_research_attempt_and_blocker_evidence": true,
    "important_chain_opportunity_resolution_requires_at_least_one_complete_non_review_valuation": true,
    "publishable_opportunity_requires_complete_bridge": true,
    "current_price_must_not_feed_intrinsic_value": true,
    "extreme_valuation_deviation_audit": {
      "required": true,
      "trigger_if_reasonable_lower_bound_is_at_least_multiple_of_current_price": 1.5,
      "trigger_if_current_price_is_at_least_multiple_of_reasonable_upper_bound": 1.5,
      "requires_independent_secondary_method": true,
      "requires_share_count_and_corporate_action_recheck": true,
      "requires_cycle_or_growth_persistence_recheck": true,
      "max_method_midpoint_divergence_pct_before_model_instability": 30.0,
      "if_audit_fails": "review_required:model_instability"
    },
    "core_earnings_preferred_over_parent_netprofit_when_nonrecurring_dominant": true,
    "nonrecurring_dominance_threshold_of_parent_netprofit": 0.3,
    "parent_netprofit_contaminated_by_material_nonrecurring_items_cannot_feed_forward_bridge": true,
    "missing_required_core_earnings_evidence_after_light_screen_means_review_required": "nonrecurring_earnings_dominant"
  },
  "buy_point_contract": {
    "purpose": "买点必须是价值安全边际与价格结构时机的交集，不能由任一单独维度替代。",
    "required_for_every_complete_non_review_valuation": true,
    "required_fields": [
      "code",
      "value_eligible",
      "timing_eligible",
      "buy_point_status",
      "buy_price_range",
      "buy_point_basis",
      "structure_entry_range",
      "invalidation_price"
    ],
    "allowed_buy_point_status": [
      "buyable_now",
      "watch_value",
      "watch_structure",
      "avoid",
      "review_required"
    ],
    "value_eligible_requires_current_price_at_or_below_safe_upper_bound": true,
    "timing_eligible_structure_types": [
      "pullback",
      "breakout",
      "trend_continuation"
    ],
    "timing_eligible_forbids_high_chase_risk": true,
    "buy_price_range_must_equal_intersection_of_safe_price_range_and_structure_entry_range": true,
    "empty_intersection_means_not_buyable_now": true,
    "damaged_or_overheated_cannot_be_buyable_now": true,
    "buyable_now_requires_value_and_timing_true": true,
    "price_structure_must_not_modify_intrinsic_value": true
  },
  "research_state_contract": {
    "path": "data/research/v2/research_state.json",
    "manifest_schema_field": "manifest_schema",
    "manifest_schema_must_equal_current": true,
    "required_top_level_sections": [
      "coverage_ledger",
      "market_profitability_radar",
      "profit_chains",
      "company_light_screen",
      "chain_comparisons",
      "companies",
      "valuation_set",
      "valuations",
      "price_structures",
      "buy_point_assessments",
      "diagnostics"
    ],
    "required_run_fields": [
      "scan_mode",
      "weekly_baseline_date"
    ],
    "on_incomplete": "incomplete_research",
    "incomplete_must_not_publish_new_current_opportunities": true,
    "required_coverage_diagnostics": [
      "coverage.taxonomy",
      "coverage.expected_counts",
      "coverage.accounted_for_counts",
      "coverage.missing_level1",
      "coverage.missing_level2",
      "coverage.missing_level3",
      "coverage.profitability_discovery_gate_passed",
      "coverage.unresolved_must_split_chains",
      "coverage.deep_nodes_total",
      "coverage.deep_nodes_resolved",
      "coverage.completion_gate_passed"
    ],
    "required_valuation_diagnostics": [
      "valuation.valuation_set_count",
      "valuation.executed_count",
      "valuation.complete_non_review_count",
      "valuation.review_required_count",
      "valuation.extreme_deviation_audit_count",
      "valuation.valuation_gate_passed"
    ]
  },
  "completion_gate_contract": {
    "coverage_exact_and_complete": true,
    "all_deep_nodes_resolved": true,
    "all_confirmed_improving_chains_company_screened": true,
    "no_research_admission_top_n_truncation": true,
    "all_light_screen_survivors_compared": true,
    "valuation_set_dedup_complete": true,
    "all_valuation_set_companies_executed": true,
    "all_triggered_extreme_valuation_audits_pass_or_review": true,
    "all_complete_non_review_companies_have_buy_point_assessment": true,
    "current_opportunities_must_come_only_from_buyable_now": true
  },
  "persistence_contract": {
    "only_prompt_research_output": "data/research/v2/research_state.json",
    "persistent_intermediate_research_outputs_allowed": false,
    "cross_run_candidate_or_opportunity_caches_allowed": false,
    "weekly_profitability_baseline_is_allowed_only_inside_research_state": true,
    "previous_state_may_seed_daily_industry_baseline_only": true,
    "previous_companies_chains_valuations_opportunities_may_not_seed_1800_discovery": true,
    "0600_requires_valid_previous_1800_state": true
  },
  "public_output": {
    "sections": [
      "执行状态",
      "全市场盈利景气雷达",
      "完整盈利产业链雷达",
      "链内公司轻筛与横向比较",
      "估值与价格区间",
      "价格结构与时机",
      "当前买点",
      "诊断"
    ],
    "company_columns": [
      "公司",
      "当前价格",
      "合理价格",
      "安全价格（低风险区）",
      "估值位置",
      "价格结构",
      "当前买入区间",
      "动作"
    ]
  },
  "rule_ownership": {
    "manifest": "保存机器契约、扫描节奏、全盈利链公司轻筛守恒、估值异常审计、买点交集与输出契约。",
    "skills": "保存盈利研究、公司轻筛/横比/去重、估值和价格结构业务规则。",
    "prompt": "执行周度全量或日度增量研究，不维护候选池，不做研究准入Top-N截断。"
  }
}