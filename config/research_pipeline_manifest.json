{
  "schema_version": 25,
  "pipeline": "a_share_low_risk_v2",
  "mode": "shadow",
  "architecture": "prompt_first_research",
  "production_gate": {"enabled": false, "label": "V2影子研究，不发布正式买点"},
  "authoritative_skills": {
    "orchestrator": "skills/a-share-low-risk/orchestrator/SKILL.md",
    "company_research": "skills/a-share-low-risk/company-research/SKILL.md",
    "valuation": "skills/a-share-low-risk/valuation/SKILL.md",
    "price_structure": "skills/a-share-low-risk/price-structure/SKILL.md"
  },
  "authoritative_data": {
    "industry_coverage_taxonomy": "config/industry_scan_universe.json",
    "company_index": "data/research/company_industry_index.json",
    "full_market_price_structure": "data/research/v2/full_market_price_structure.json",
    "latest_market": "data/latest.json",
    "bounded_history_store": "data/history_shards/*.json",
    "research_state": "data/research/v2/research_state.json"
  },
  "evidence_contract": {
    "repository_whitelist_applies_only_to_persistent_mechanical_data": true,
    "current_public_research_evidence_allowed": true,
    "current_public_research_evidence_required_for_1800_full_research": true,
    "preferred_sources": ["公司公告与财报", "交易所披露", "官方统计", "行业协会与产业公开数据", "可信商品价格/价差/订单/产销数据", "必要时高质量新闻与研究资料"],
    "evidence_uses": ["行业收入利润与利润率", "订单/出货/销量/产量", "产品价格与价差", "库存/开工/产能利用率", "公司主营/扣非/现金流", "Forward Bridge与反向证据"],
    "public_evidence_must_not_be_persisted_as_cross_run_candidate_or_opportunity_pool": true
  },
  "stage_order": ["data_health", "taxonomy_coverage", "market_profitability_discovery", "profit_chain_decomposition", "chain_company_comparison", "valuation", "price_structure", "completion_gate_and_opportunity_synthesis"],
  "coverage_contract": {
    "taxonomy": "申万行业分类标准2021版",
    "expected_counts": {"level1": 31, "level2": 134, "level3": 346},
    "purpose": "只负责防漏和完成度验收，不作为景气答案池或固定盈利链答案。",
    "completion_gate": {
      "all_nodes_accounted_for": true,
      "missing_nodes_must_be_empty": true,
      "unresolved_must_split_chains_must_be_empty": true,
      "strong_improving_or_divergent_nodes_require_profit_chain_research": true,
      "important_chains_require_multi_company_comparison_when_peers_exist": true
    }
  },
  "research_state_contract": {
    "path": "data/research/v2/research_state.json",
    "manifest_schema_field": "manifest_schema",
    "manifest_schema_must_equal_current": true,
    "on_incomplete": "incomplete_research",
    "incomplete_must_not_publish_new_current_opportunities": true,
    "required_coverage_diagnostics": ["coverage.taxonomy", "coverage.expected_counts", "coverage.accounted_for_counts", "coverage.missing_level1", "coverage.missing_level2", "coverage.missing_level3", "coverage.unresolved_must_split_chains", "coverage.completion_gate_passed"]
  },
  "persistence_contract": {
    "only_prompt_research_output": "data/research/v2/research_state.json",
    "persistent_intermediate_research_outputs_allowed": false,
    "cross_run_candidate_or_opportunity_caches_allowed": false,
    "previous_state_may_not_seed_1800_discovery": true,
    "0600_requires_valid_previous_1800_state": true
  },
  "public_output": {
    "sections": ["执行状态", "全市场盈利景气雷达", "完整盈利产业链雷达", "链内公司比较", "估值与价格区间", "价格结构与时机", "当前机会", "诊断"],
    "company_columns": ["公司", "当前价格", "合理价格", "安全价格（低风险区）", "估值位置", "价格结构", "动作"]
  },
  "rule_ownership": {
    "manifest": "只保存机器契约、权威仓库数据路径、公开证据边界、固定计数、阶段顺序和输出契约。",
    "skills": "保存研究方法、盈利链拆分、公司验证、估值和价格结构业务规则。",
    "prompt": "执行当期开放式公开研究，不维护跨期研究池。"
  }
}
