{
  "schema_version": 5,
  "pipeline": "a_share_low_risk",
  "authoritative_files": {
    "orchestrator_skill": "skills/a-share-low-risk/orchestrator/SKILL.md",
    "industry_registry": "config/industry_scan_universe.json",
    "company_index": "data/research/company_industry_index.json",
    "company_registry": "data/research/company_industry_registry.json",
    "valuation_policy_registry": "config/valuation_policy_registry.json",
    "cycle_valuation_policy": "config/cycle_valuation_policy.json",
    "cycle_regime_registry": "config/cycle_regime_registry.json",
    "weekly_pool": "data/research/weekly_fundamental_opportunity_pool.json",
    "market_health": "data/health.json",
    "backfill_status": "data/backfill_status.json"
  },
  "maintenance": {
    "company_index_builder": "scripts/build_company_industry_index.py",
    "company_index_workflow": ".github/workflows/build-company-industry-index.yml",
    "valuation_workflow": ".github/workflows/build-forward-valuation.yml",
    "company_index_dependency_file": "requirements-research.txt"
  },
  "stages": [
    {"id":"company_index_health","input":"data/research/company_industry_index.json","validator":"python scripts/validate_research_pipeline.py company-index data/research/company_industry_index.json","failure_policy":"do_not_silently_drop_missing_or_unmapped_codes; pass them into every T2 chain as unknown candidates"},
    {"id":"industry_scan","skill":"skills/a-share-low-risk/industry-scan/SKILL.md","output":"data/research/pipeline/industry_scan.json","validator":"python scripts/validate_research_pipeline.py industry-scan data/research/pipeline/industry_scan.json"},
    {"id":"t2_company_recall","requires":["company_index_health","industry_scan"],"skill":"skills/a-share-low-risk/t2-company-recall/SKILL.md","output":"data/research/pipeline/t2_company_recall.json","validator":"python scripts/validate_t2_recall_v2.py data/research/pipeline/t2_company_recall.json --industry-scan data/research/pipeline/industry_scan.json"},
    {"id":"weekly_opportunity_scan","requires":["industry_scan","t2_company_recall"],"skill":"skills/a-share-low-risk/weekly-opportunity-scan/SKILL.md","output":"data/research/pipeline/weekly_opportunity_scan.json","persistent_output":"data/research/weekly_fundamental_opportunity_pool.json","validator":"python scripts/validate_research_outputs.py weekly-scan data/research/pipeline/weekly_opportunity_scan.json"},
    {"id":"stage_order","requires":["industry_scan","t2_company_recall","weekly_opportunity_scan"],"run_state":"data/research/pipeline/run_state.json","validator":"python scripts/validate_research_pipeline.py stage-order data/research/pipeline/run_state.json"},
    {"id":"earnings_validation","skill":"skills/a-share-low-risk/earnings-validation/SKILL.md","output":"data/research/pipeline/earnings_validation.json"},
    {"id":"left_value_fundamental","requires":["earnings_validation"],"skill":"skills/a-share-low-risk/fundamental-valuation/SKILL.md","policy":"config/valuation_policy_registry.json","runner":"python scripts/build_forward_valuation_v5.py","output":"data/research/pipeline/fundamental_valuation.json","validator":"python scripts/validate_research_outputs.py fundamental-valuation data/research/pipeline/fundamental_valuation.json"},
    {"id":"left_value_cycle","requires":["earnings_validation"],"skill":"skills/a-share-low-risk/cycle-valuation/SKILL.md","policy":"config/cycle_valuation_policy.json","cycle_regime":"config/cycle_regime_registry.json","runner":"python scripts/build_cycle_valuation.py","output":"data/research/pipeline/cycle_valuation.json","validator":"python scripts/validate_research_outputs.py cycle-valuation data/research/pipeline/cycle_valuation.json"},
    {"id":"valuation_policy_audit","requires":["left_value_fundamental","left_value_cycle"],"runner":"python scripts/build_valuation_policy_audit.py","output":"data/research/pipeline/valuation_policy_audit.json","validator":"python scripts/validate_research_outputs.py valuation-policy-audit data/research/pipeline/valuation_policy_audit.json","failure_policy":"unsupported_policy_count_must_equal_zero; common_pool_coverage_must_equal_100_percent"},
    {"id":"left_value_merge","requires":["left_value_fundamental","left_value_cycle","valuation_policy_audit"],"runner":"python scripts/merge_left_valuation.py","output":"data/research/pipeline/left_valuation_scan.json","validator":"python scripts/validate_research_outputs.py left-valuation data/research/pipeline/left_valuation_scan.json"},
    {"id":"right_structure","requires":["earnings_validation"],"skill":"skills/a-share-low-risk/technical-structure/SKILL.md","output":"data/research/pipeline/right_structure_scan.json"},
    {"id":"final_selection","requires":["left_value_merge","right_structure"],"skill":"skills/a-share-low-risk/final-selection/SKILL.md","output":"data/research/pipeline/final_selection.json","validator":"python scripts/validate_research_outputs.py final-selection data/research/pipeline/final_selection.json"}
  ],
  "hard_stop_on_validator_failure": true,
  "weekly_pool_forbidden_before_stage": "weekly_opportunity_scan",
  "recall_principle": "LLM classifies mechanically enumerated industries and companies; it does not recall the research universe from memory",
  "valuation_principle": "Every non-cycle candidate must map to a versioned PE/PB/other valuation policy; unsupported_policy=0 is a hard gate. Financial PB-ROE uses reported BVPS from financial statements rather than requiring a fragile real-time PB feed. Resource cycle valuation must use current+next-year earnings, a reviewed 6-18m cycle regime and fresh commodity/cost anchors. Peak earnings and short-term commodity strength cannot be capitalized alone.",
  "selection_principle": "final selection only selects validated upstream outputs; it never repairs upstream calculations"
}
