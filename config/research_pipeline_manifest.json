{
  "schema_version": 26,
  "pipeline": "a_share_low_risk_v2",
  "mode": "shadow",
  "architecture": "prompt_first_research",
  "production_gate": {"enabled": false, "label": "V2影子研究，不发布正式买点"},
  "authoritative_skills": {
    "orchestrator": "skills/a-share-low-risk/orchestrator/SKILL.md",
    "company_research": "skills/a-share-low-risk/company-research/SKILL.md",
    "valuation": "skills/a-share-low-risk/valuation/SKILL.md",
    "price_structure": "skills/a-share-low-risk/price-structure/SKILL.md"
  },
  "authoritative_data": {
    "industry_coverage_taxonomy": "config/industry_scan_universe.json",
    "company_index": "data/research/company_industry_index.json",
    "full_market_price_structure": "data/research/v2/full_market_price_structure.json",
    "latest_market": "data/latest.json",
    "bounded_history_store": "data/history_shards/*.json",
    "research_state": "data/research/v2/research_state.json"
  },
  "evidence_contract": {
    "repository_whitelist_applies_only_to_persistent_mechanical_data": true,
    "current_public_research_evidence_allowed": true,
    "current_public_research_evidence_required_for_1800_full_research": true,
    "preferred_sources": ["公司公告与财报", "交易所披露", "官方统计", "行业协会与产业公开数据", "可信商品价格/价差/订单/产销数据", "必要时高质量新闻与研究资料"],
    "evidence_uses": ["行业收入利润与利润率", "订单/出货/销量/产量", "产品价格与价差", "库存/开工/产能利用率", "公司主营/扣非/现金流", "Forward Bridge与反向证据"],
    "public_evidence_must_not_be_persisted_as_cross_run_candidate_or_opportunity_pool": true
  },
  "stage_order": ["data_health", "taxonomy_coverage", "market_profitability_discovery", "profit_chain_decomposition", "chain_company_comparison", "valuation", "price_structure", "completion_gate_and_opportunity_synthesis"],
  "coverage_contract": {
    "taxonomy": "申万行业分类标准2021版",
    "expected_counts": {"level1": 31, "level2": 134, "level3": 346},
    "purpose": "逐节点防漏和完成度验收，不作为景气答案池或固定盈利链答案。",
    "ledger_contract": {
      "state_path": "coverage_ledger",
      "instantiate_all_taxonomy_nodes_before_market_discovery": true,
      "exact_node_counts_must_match_taxonomy": true,
      "required_node_fields": ["code", "name", "level", "parent_code", "accounted_for", "status", "scan_depth", "evidence_scope", "evidence_basis", "needs_profit_chain_research", "profit_chain_resolution"],
      "allowed_statuses": ["strong_improving", "improving", "stable", "weak", "deteriorating", "divergent", "unconfirmed", "not_applicable"],
      "allowed_scan_depth": ["shallow", "deep"],
      "allowed_evidence_scope": ["direct_node", "parent_supported", "cross_sectional", "insufficient"],
      "deep_research_statuses": ["strong_improving", "improving", "deteriorating", "divergent"],
      "shallow_allowed_statuses": ["stable", "weak", "unconfirmed", "not_applicable"],
      "accounted_for_definition": "节点必须在ledger中有唯一记录，status/scan_depth/evidence_scope/evidence_basis均非空，并明确needs_profit_chain_research；仅有父级名称或汇总方向不能算accounted_for。",
      "parent_supported_rule": "仅允许stable/weak/unconfirmed/not_applicable浅扫节点使用；若存在节点级强化、恶化或分化证据，必须改为direct_node或cross_sectional并升级deep。",
      "grouped_placeholder_rows_forbidden": true,
      "null_accounted_for_counts_forbidden": true,
      "missing_arrays_must_contain_actual_taxonomy_codes": true,
      "counts_must_be_derived_from_ledger_not_manually_asserted": true
    },
    "completion_gate": {
      "coverage_ledger_exact_match": true,
      "all_nodes_accounted_for": true,
      "missing_nodes_must_be_empty": true,
      "unresolved_must_split_chains_must_be_empty": true,
      "all_deep_nodes_require_profit_chain_resolution": true,
      "important_chains_require_multi_company_comparison_when_peers_exist": true,
      "important_chains_require_opportunity_resolution": true
    }
  },
  "profit_chain_resolution_contract": {
    "required_for_each_deep_coverage_node": true,
    "allowed_resolution": ["resolved", "unconfirmed_with_evidence_gap"],
    "must_split_or_continue_split_cannot_remain_open": true,
    "required_chain_fields": ["chain_id", "source_coverage_codes", "direct_driver", "leading_variables", "profit_transmission", "forward_bridge", "invalidation_condition", "resolution_status"]
  },
  "company_comparison_contract": {
    "comparison_occurs_before_final_valuation": true,
    "when_two_or_more_comparable_main_board_peers_exist_minimum_companies": 2,
    "comparison_complete_required_when_peers_exist": true,
    "single_company_chain_requires_explicit_singleton_reason": true,
    "required_outputs": ["compared_companies", "comparison_complete", "fundamental_best", "current_opportunity_best", "opportunity_resolution_complete"],
    "current_opportunity_best_may_be_null": true
  },
  "valuation_resolution_contract": {
    "required_bridge_fields": ["current_price", "price_date", "earnings_type", "earnings_basis", "primary_method", "key_assumptions", "reasonable_price_assumption", "reasonable_price_range", "uncertainty", "margin_of_safety_reason", "safe_price_range", "valuation_position", "falsifiers"],
    "publishable_opportunity_requires_complete_bridge": true,
    "review_required_is_not_publishable_opportunity": true,
    "review_required_may_resolve_chain_as_no_current_opportunity_if_reason_is_explicit": true,
    "current_price_must_not_feed_intrinsic_value": true
  },
  "research_state_contract": {
    "path": "data/research/v2/research_state.json",
    "manifest_schema_field": "manifest_schema",
    "manifest_schema_must_equal_current": true,
    "required_top_level_sections": ["coverage_ledger", "market_profitability_radar", "profit_chains", "chain_comparisons", "companies", "valuations", "price_structures", "diagnostics"],
    "on_incomplete": "incomplete_research",
    "incomplete_must_not_publish_new_current_opportunities": true,
    "required_coverage_diagnostics": ["coverage.taxonomy", "coverage.expected_counts", "coverage.accounted_for_counts", "coverage.missing_level1", "coverage.missing_level2", "coverage.missing_level3", "coverage.unresolved_must_split_chains", "coverage.deep_nodes_total", "coverage.deep_nodes_resolved", "coverage.completion_gate_passed"]
  },
  "persistence_contract": {
    "only_prompt_research_output": "data/research/v2/research_state.json",
    "persistent_intermediate_research_outputs_allowed": false,
    "cross_run_candidate_or_opportunity_caches_allowed": false,
    "previous_state_may_not_seed_1800_discovery": true,
    "0600_requires_valid_previous_1800_state": true
  },
  "public_output": {
    "sections": ["执行状态", "全市场盈利景气雷达", "完整盈利产业链雷达", "链内公司比较", "估值与价格区间", "价格结构与时机", "当前机会", "诊断"],
    "company_columns": ["公司", "当前价格", "合理价格", "安全价格（低风险区）", "估值位置", "价格结构", "动作"]
  },
  "rule_ownership": {
    "manifest": "保存机器契约、权威仓库数据路径、公开证据边界、Coverage ledger、阶段完成条件和输出契约。",
    "skills": "保存研究方法、盈利链拆分、公司验证、估值和价格结构业务规则。",
    "prompt": "执行当期开放式公开研究，不维护跨期研究池。"
  }
}
