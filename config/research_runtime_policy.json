{
  "schema_version": 11,
  "pipeline": "a_share_low_risk_v2",
  "research_read_mode": "manifest_repo_data_plus_current_public_evidence",
  "manifest_path": "config/research_pipeline_manifest.json",
  "active_state_path": "data/research/v2/research_state.json",
  "state_compatibility": {
    "required_manifest_schema_match": true,
    "on_manifest_schema_mismatch": "stale_state_do_not_use_as_current",
    "on_missing_state": "no_valid_previous_research_state",
    "valid_industry_baseline_is_independent_of_generation_clock": true,
    "morning_run_requires_valid_previous_1800_state": false,
    "morning_run_requires_valid_current_schema_industry_baseline": true,
    "valid_industry_baseline_conditions": [
      "manifest schema matches current schema",
      "taxonomy coverage contains exact 31/134/346 routing nodes",
      "Prompt full-market prosperity search completed without Top-N truncation",
      "every selected prosperity direction has taxonomy mapping and all mapped relevant level3 profitability verification complete",
      "prosperity search and level3 gate passed",
      "weekly baseline age is within manifest freshness limit",
      "baseline data cutoff and latest completed trade date are explicit"
    ],
    "scheduled_1800_is_refresh_anchor_not_baseline_eligibility_requirement": true
  },
  "repository_data_policy": {
    "allow_only_manifest_authoritative_data": true,
    "do_not_scan_repository_for_extra_research_json": true,
    "git_history_is_audit_only_not_runtime_input": true
  },
  "public_evidence_policy": {
    "allowed": true,
    "required_for_1800_research": true,
    "use_current_public_sources_for_fundamental_and_industry_evidence": true,
    "not_subject_to_repository_file_whitelist": true
  },
  "discovery_policy": {
    "weekly_industry_baseline_may_carry_forward_between_full_scans": true,
    "previous_state_may_seed_only_industry_baseline_for_daily_incremental": true,
    "previous_companies_chains_valuations_or_opportunities_may_not_seed_1800_discovery": true,
    "previous_companies_chains_valuations_or_opportunities_may_not_seed_manual_or_morning_company_discovery": true,
    "cross_run_candidate_or_opportunity_pools_forbidden": true,
    "research_admission_top_n_forbidden": true,
    "research_admission_per_level1_chain_cap_forbidden": true,
    "prosperity_selection_top_n_forbidden": true,
    "selected_direction_level3_expansion_cap_forbidden": true,
    "weekly_prompt_full_market_prosperity_search_cannot_be_replaced_by_previous_focus_list": true,
    "persistent_level1_level2_prosperity_status_forbidden": true
  },
  "stage_execution_policy": {
    "daily_incremental_requires_valid_weekly_baseline": true,
    "valid_weekly_baseline_may_be_generated_by_bootstrap_manual_or_scheduled_full_scan": true,
    "company_research_may_start_from_valid_industry_baseline_regardless_of_baseline_generation_time": true,
    "coverage_counts_must_be_derived_from_node_ledger": true,
    "deep_nodes_must_be_resolved_before_completion_gate": true,
    "every_confirmed_improving_chain_must_receive_company_light_screen": true,
    "all_mapped_mainboard_companies_in_chain_must_be_light_screened_before_any_ranking": true,
    "light_screen_exclusions_require_company_specific_evidence": true,
    "all_light_screen_survivors_must_be_horizontally_compared": true,
    "cross_chain_duplicate_company_must_preserve_all_chain_memberships": true,
    "valuation_set_must_be_deduplicated_by_stock_code": true,
    "all_compared_companies_must_enter_valuation_set": true,
    "every_valuation_set_company_must_be_executed": true,
    "corporate_action_check_must_precede_earnings_bridge": true,
    "historical_eps_scaling_across_material_share_change_forbidden": true,
    "resource_and_order_cycle_current_growth_pe_shortcut_forbidden": true,
    "extreme_valuation_deviation_requires_independent_secondary_method": true,
    "review_required_is_exception_not_completion_shortcut": true,
    "every_complete_non_review_company_requires_buy_point_assessment": true,
    "buy_point_requires_value_and_timing_intersection": true,
    "current_opportunity_requires_buyable_now": true,
    "core_earnings_quality_must_be_verified_before_light_screen_survive": true,
    "missing_deducted_profit_cannot_silently_pass_earnings_quality": true,
    "material_nonrecurring_parent_profit_cannot_feed_valuation_bridge": true,
    "every_complete_non_review_company_requires_near_miss_distance": true,
    "near_miss_top10_must_be_output_when_eligible_universe_nonempty": true,
    "empty_current_opportunities_does_not_allow_empty_near_miss_output": true,
    "weekly_full_scan_does_not_require_all_346_level3_profitability_reviews": true,
    "prosperity_discovery_top_n_forbidden": true,
    "every_expanded_level3_must_be_profitability_verified": true,
    "unselected_level3_may_remain_taxonomy_only": true,
    "coverage_ledger_must_be_instantiated_before_market_prosperity_search": true,
    "weekly_full_requires_prompt_full_market_prosperity_search": true,
    "weekly_full_must_not_build_level1_level2_status_matrix": true,
    "prosperity_search_must_precede_level3_profitability_verification": true,
    "prosperity_search_top_n_forbidden": true,
    "every_selected_direction_must_map_to_relevant_level3": true,
    "every_mapped_relevant_level3_must_be_profitability_verified": true,
    "daily_incremental_uses_prompt_search_for_new_or_changed_prosperity_evidence": true,
    "valuation_archetype_required_before_model_execution": true,
    "sw_level1_only_valuation_model_selection_forbidden": true,
    "resource_asset_fixed_pe_only_valuation_forbidden": true,
    "spread_cyclical_fixed_pe_only_valuation_forbidden": true,
    "base_and_downside_scenarios_required_for_non_review_valuation": true,
    "safe_price_ceiling_required_for_value_eligibility": true,
    "fixed_discount_from_reasonable_lower_bound_forbidden": true,
    "extreme_deviation_secondary_method_must_use_independent_value_driver_family": true,
    "same_eps_different_pe_is_not_independent_secondary_method": true,
    "near_miss_action_distance_is_primary_sort_metric": true,
    "near_miss_far_names_must_be_labeled_far": true,
    "legacy_safe_upper_bound_value_eligibility_forbidden": true,
    "required_archetype_input_completeness_must_be_audited": true,
    "generic_pe_fallback_when_archetype_inputs_missing_forbidden": true,
    "primary_secondary_model_family_independence_must_be_audited": true,
    "near_miss_missing_hard_conditions_must_be_retained_as_step_count": true,
    "near_miss_unmeasurable_structure_distance_must_not_be_fabricated": true
  },
  "write_policy": {
    "current_research_output_only": "data/research/v2/research_state.json",
    "weekly_baseline_must_live_inside_research_state": true,
    "persistent_intermediate_research_outputs_forbidden": true,
    "never_relabel_old_state_to_new_schema": true,
    "new_state_must_record_manifest_schema": true,
    "new_state_must_include_coverage_ledger_company_light_screen_buy_points_and_scan_mode": true,
    "new_state_must_include_near_miss_ranking": true,
    "new_state_must_include_market_prosperity_search_and_level3_verification": true,
    "new_state_must_include_valuation_engine_v2_fields": true
  }
}