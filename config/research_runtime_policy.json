{
  "contract_id": "a-share-low-risk-production",
  "pipeline": "a_share_low_risk",
  "mode": "production",
  "research_read_mode": "manifest_repo_data_plus_current_public_evidence",
  "manifest_path": "config/research_pipeline_manifest.json",
  "industry_state_path": "data/research/industry_state.json",
  "active_state_path": "data/research/research_state.json",
  "read_order": [
    "config/research_runtime_policy.json",
    "config/research_pipeline_manifest.json",
    "manifest.authoritative_skills"
  ],
  "repository_data_policy": {
    "allow_only_manifest_authoritative_data": true,
    "do_not_scan_repository_for_extra_research_json": true,
    "legacy_v2_research_files_are_not_runtime_input": true,
    "git_history_is_audit_only_not_runtime_input": true
  },
  "public_evidence_policy": {
    "allowed": true,
    "required_for_formal_research": true,
    "use_current_public_sources_for_fundamental_and_industry_evidence": true,
    "not_subject_to_repository_file_whitelist": true
  },
  "data_gate_policy": {
    "must_run_before_all_formal_research": true,
    "expected_trade_date_is_most_recent_completed_a_share_session": true,
    "health_trade_date_must_match_expected_trade_date": true,
    "health_market_status_must_be_closed": true,
    "source_errors_must_be_empty": true,
    "latest_history_and_price_structure_must_match_expected_trade_date": true,
    "fail_closed": true,
    "failure_may_not_publish_new_formal_result": true,
    "failure_may_not_overwrite_previous_valid_state": true
  },
  "discovery_policy": {
    "prompt_full_market_light_recall_required_every_run": true,
    "daily_run_may_not_limit_prompt_discovery_to_previous_directions": true,
    "previous_industry_state_may_accelerate_level3_refresh_but_may_not_bound_discovery": true,
    "previous_companies_chains_valuations_or_opportunities_may_not_seed_discovery": true,
    "cross_run_candidate_or_opportunity_pools_forbidden": true,
    "research_admission_top_n_forbidden": true,
    "research_admission_per_level1_chain_cap_forbidden": true,
    "persistent_level1_level2_prosperity_status_forbidden": true
  },
  "level3_refresh_policy": {
    "bootstrap_full_refresh_required_when_state_missing_invalid_or_requires_full_refresh": true,
    "bootstrap_ignores_weekly_anchor": true,
    "bootstrap_must_complete_before_daily_incremental_mode": true,
    "weekly_full_anchor": "Friday 18:00 Asia/Shanghai",
    "weekly_full_fallback_next_available_weekday_1800": true,
    "daily_incremental_between_full_refreshes": true,
    "weekly_full_revalidates_all_level3_mapped_from_current_discovery": true,
    "daily_incremental_rechecks_level3_only_when_new_or_changed_evidence_exists": true,
    "unselected_level3_may_remain_taxonomy_only": true,
    "industry_state_is_valid_independent_of_generation_clock_if_fresh": true
  },
  "stage_execution_policy": {
    "prompt_full_market_discovery_must_precede_taxonomy_mapping": true,
    "taxonomy_mapping_must_precede_level3_profitability_refresh": true,
    "company_admission_accepts_improving": true,
    "company_admission_accepts_stable_divergent": true,
    "stable_divergent_does_not_relax_downstream_thresholds": true,
    "deteriorating_or_unconfirmed_cannot_enter_company_layer": true,
    "every_admitted_chain_must_resolve_driver_and_profit_transmission": true,
    "company_mapping_gate_must_run_before_company_screen": true,
    "all_missing_or_unmapped_company_index_codes_must_be_checked_for_admitted_scope": true,
    "unresolved_in_scope_company_mapping_fails_completion": true,
    "every_admitted_chain_must_receive_company_light_screen": true,
    "all_mapped_mainboard_companies_in_chain_must_be_light_screened_before_any_ranking": true,
    "light_screen_exclusions_require_company_specific_evidence": true,
    "core_earnings_quality_must_be_verified_before_light_screen_survive": true,
    "missing_deducted_profit_cannot_silently_pass_earnings_quality": true,
    "all_light_screen_survivors_must_be_horizontally_compared": true,
    "cross_chain_duplicate_company_must_preserve_all_chain_memberships": true,
    "valuation_set_must_be_deduplicated_by_stock_code": true,
    "all_compared_companies_must_enter_valuation_set": true,
    "every_valuation_set_company_must_be_executed": true,
    "corporate_action_check_must_precede_earnings_bridge": true,
    "historical_eps_scaling_across_material_share_change_forbidden": true,
    "normal_profitable_company_uses_simple_relative_valuation_by_default": true,
    "default_valuation_requires_pe_dynamic_pe_pb_roe_core_growth_level3_peers": true,
    "default_valuation_requires_180d_market_sanity": true,
    "complex_absolute_valuation_is_exception_only": true,
    "exception_trigger_required_before_complex_model": true,
    "single_margin_of_safety_application_required": true,
    "every_complete_non_review_company_requires_price_structure": true,
    "every_complete_non_review_company_requires_buy_point_assessment": true,
    "buy_point_requires_value_and_timing_intersection": true,
    "current_opportunity_requires_buyable_now": true,
    "every_complete_non_review_company_requires_near_miss_distance": true,
    "near_miss_top10_must_be_output_when_eligible_universe_nonempty": true,
    "empty_current_opportunities_does_not_allow_empty_near_miss_output": true
  },
  "write_policy": {
    "industry_state_output": "data/research/industry_state.json",
    "current_research_output": "data/research/research_state.json",
    "full_market_price_structure_output": "data/research/full_market_price_structure.json",
    "industry_state_is_only_cross_run_fundamental_memory": true,
    "current_research_state_is_latest_valid_formal_run_only": true,
    "persistent_intermediate_research_outputs_forbidden": true,
    "persistent_candidate_or_opportunity_pools_forbidden": true,
    "standalone_valuation_cache_forbidden": true,
    "write_only_after_data_gate_and_completion_gate_pass": true,
    "failed_or_stale_run_must_not_mutate_previous_valid_state": true
  },
  "production_policy": {
    "formal_publish_enabled": true,
    "shadow_mode_forbidden": true,
    "numeric_schema_versioning_for_research_contract_forbidden": true,
    "contract_changes_update_manifest_policy_skills_and_tests_together": true
  }
}
